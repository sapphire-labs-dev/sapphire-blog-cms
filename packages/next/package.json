{
  "name": "@sapphirelabs/blog-cms-next",
  "version": "1.0.0",
  "description": "Sapphire Blog CMS for Next.js: CMS panel at /admin, post loading helpers and a component that renders the text.",
  "license": "MIT",
  "author": "Sapphire Labs (https://github.com/sapphire-labs-dev)",
  "homepage": "https://github.com/sapphire-labs-dev/sapphire-blog-cms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapphire-labs-dev/sapphire-blog-cms.git",
    "directory": "packages/next"
  },
  "bugs": "https://github.com/sapphire-labs-dev/sapphire-blog-cms/issues",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./admin": "./dist/admin.js",
    "./prose.css": "./dist/prose.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nextjs",
    "cms",
    "markdown"
  ],
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').copyFileSync('../app/public/prose.css', 'dist/prose.css')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
